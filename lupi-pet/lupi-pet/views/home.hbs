<!-- HERO -->
<section class="hero">
  <div class="hero-content">
    <div class="hero-badge">🐾 Tienda de mascotas</div>
    <h1>Todo lo que tu<br><span>mascota necesita</span></h1>
    <p>Alimentos, accesorios e higiene de calidad para perros y gatos. Pedidos por WhatsApp con envío a domicilio.</p>
    <div class="hero-cta">
      <a href="/tienda" class="btn-primary">Ver productos</a>
      <a href="https://wa.me/5215512345678" class="btn-outline" target="_blank">💬 Contáctanos</a>
    </div>
    <div class="hero-stats">
      <div class="stat"><strong>+200</strong><span>Productos</span></div>
      <div class="stat-divider"></div>
      <div class="stat"><strong>98%</strong><span>Clientes felices</span></div>
      <div class="stat-divider"></div>
      <div class="stat"><strong>24h</strong><span>Envío</span></div>
    </div>
  </div>
  <div class="hero-visual">
    <div class="hero-blob"></div>
    <div class="hero-animal">
      <div class="animal-card">
        <span class="animal-big">🐶</span>
        <div class="animal-bubble">¡Hola! 👋</div>
      </div>
      <div class="animal-card animal-card-2">
        <span class="animal-big">😸</span>
        <div class="animal-bubble animal-bubble-2">Miau 🐟</div>
      </div>
    </div>
  </div>
</section>

<!-- CATEGORÍAS -->
<section class="section categories-section">
  <div class="container">
    <div class="section-header">
      <h2>Encuentra lo que buscas</h2>
      <p>Productos para perros y gatos</p>
    </div>
    <div class="categories-grid">
      <a href="/tienda?categoria=alimentos" class="category-card cat-food">
        <span class="cat-icon">🥩</span>
        <h3>Alimentos</h3>
        <p>Nutrición de calidad</p>
        <span class="cat-arrow">→</span>
      </a>
      <a href="/tienda?categoria=accesorios" class="category-card cat-toys">
        <span class="cat-icon">🎾</span>
        <h3>Accesorios</h3>
        <p>Juguetes y más</p>
        <span class="cat-arrow">→</span>
      </a>
      <a href="/tienda?categoria=higiene" class="category-card cat-hygiene">
        <span class="cat-icon">🛁</span>
        <h3>Higiene</h3>
        <p>Cuidado y limpieza</p>
        <span class="cat-arrow">→</span>
      </a>
      <a href="/tienda?mascota=perro" class="category-card cat-dog">
        <span class="cat-icon">🐕</span>
        <h3>Para Perros</h3>
        <p>Todo para tu can</p>
        <span class="cat-arrow">→</span>
      </a>
      <a href="/tienda?mascota=gato" class="category-card cat-cat">
        <span class="cat-icon">🐈</span>
        <h3>Para Gatos</h3>
        <p>Lo mejor para tu michi</p>
        <span class="cat-arrow">→</span>
      </a>
    </div>
  </div>
</section>

<!-- PRODUCTOS DESTACADOS -->
<section class="section featured-section">
  <div class="container">
    <div class="section-header">
      <h2>⭐ Productos destacados</h2>
      <a href="/tienda" class="see-all">Ver todo →</a>
    </div>
    <div class="products-grid">
      {{#each featured}}
      <div class="product-card" data-id="{{id}}">
        {{#if badge}}<span class="product-badge">{{badge}}</span>{{/if}}
        <div class="product-emoji">{{emoji}}</div>
        <div class="product-info">
          <span class="product-pet">{{#if (eq pet 'perro')}}🐶 Perro{{else}}🐱 Gato{{/if}}</span>
          <h3>{{name}}</h3>
          <p>{{description}}</p>
          <div class="product-footer">
            <span class="product-price">${{price}} <small>MXN</small></span>
            <button class="btn-add-cart" onclick="addToCart({{id}}, '{{name}}', {{price}}, '{{emoji}}')">
              + Agregar
            </button>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>

<!-- BANNER CTA -->
