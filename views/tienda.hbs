<section class="page-hero page-hero-small">
  <div class="container">
    <h1>Tienda</h1>
    <p>{{total}} productos disponibles para tu mascota</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="shop-layout">

      <!-- Sidebar filtros -->
      <aside class="shop-filters">
        <h3>Filtros</h3>
        <form action="/tienda" method="GET">
          <div class="filter-group">
            <label>Buscar</label>
            <input type="text" name="q" value="{{q}}" placeholder="Buscar producto..." class="filter-input">
          </div>
          <div class="filter-group">
            <label>Categoria</label>
            <div class="filter-options">
              <label class="filter-opt"><input type="radio" name="categoria" value="" {{#unless categoria}}checked{{/unless}}> Todas</label>
              {{#each categories}}
              <label class="filter-opt"><input type="radio" name="categoria" value="{{slug}}" {{#if (eq ../categoria slug)}}checked{{/if}}> {{name}}</label>
              {{/each}}
            </div>
          </div>
          <div class="filter-group">
            <label>Mascota</label>
            <div class="filter-options">
              <label class="filter-opt"><input type="radio" name="mascota" value="" {{#unless mascota}}checked{{/unless}}> Todas</label>
              <label class="filter-opt"><input type="radio" name="mascota" value="perro" {{#if (eq mascota 'perro')}}checked{{/if}}> Perros</label>
              <label class="filter-opt"><input type="radio" name="mascota" value="gato" {{#if (eq mascota 'gato')}}checked{{/if}}> Gatos</label>
            </div>
          </div>
          <button type="submit" class="btn-filter">Aplicar filtros</button>
          <a href="/tienda" class="btn-clear">Limpiar</a>
        </form>
      </aside>

      <!-- Grid productos -->
      <div class="shop-main">
        {{#if products.length}}
        <div class="products-grid">
          {{#each products}}
          <a href="/producto/{{id}}" class="product-card">
            {{#if badge}}<span class="product-badge">{{badge}}</span>{{/if}}
            <div class="product-image">
              {{#if image}}
              <img src="/uploads/{{image}}" alt="{{name}}">
              {{else}}
              <div class="product-emoji">{{emoji}}</div>
              {{/if}}
            </div>
            <div class="product-info">
              <span class="product-pet">{{#if (eq pet 'perro')}}Perro{{else}}Gato{{/if}}</span>
              <h3>{{name}}</h3>
              <p>{{description}}</p>
              <div class="product-footer">
                <span class="product-price">${{price}} <small>MXN</small></span>
                <button class="btn-add-cart" onclick="addToCart({{id}}, '{{name}}', {{price}}); event.preventDefault(); event.stopPropagation();">
                  + Agregar
                </button>
              </div>
            </div>
          </a>
          {{/each}}
        </div>
        {{else}}
        <div class="empty-state">
          <h3>Sin resultados</h3>
          <p>No encontramos productos con esos filtros. Intenta con otra busqueda.</p>
          <a href="/tienda" class="btn-primary">Ver todos los productos</a>
        </div>
        {{/if}}
      </div>

    </div>
  </div>
</section>