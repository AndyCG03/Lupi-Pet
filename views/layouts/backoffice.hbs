<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--cream); font-family: 'Baloo 2', cursive; }
    .bo-layout { display: flex; min-height: 100vh; }
    .bo-sidebar { width: 240px; background: var(--text); color: var(--white); padding: 24px; flex-shrink: 0; position: fixed; height: 100vh; left: 0; top: 0; overflow-y: auto; }
    .bo-sidebar h2 { color: var(--orange); margin: 0 0 24px 0; font-size: 1.3rem; }
    .bo-sidebar a { display: block; color: rgba(255,255,255,.7); padding: 12px 16px; border-radius: 8px; transition: all .2s; margin-bottom: 4px; }
    .bo-sidebar a:hover, .bo-sidebar a.active { background: rgba(255,255,255,.1); color: var(--white); }
    .bo-main { flex: 1; margin-left: 240px; padding: 32px; background: var(--cream); }
    .bo-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px; }
    .bo-header h1 { font-size: 1.8rem; font-weight: 800; margin: 0; }
    .bo-btn { background: var(--orange); color: var(--white); padding: 10px 20px; border-radius: 50px; font-weight: 700; display: inline-block; text-decoration: none; transition: all .2s; }
    .bo-btn:hover { background: var(--orange-dark); }
    .bo-btn-gray { background: var(--gray); color: var(--text); }
    .bo-toggle { display: none; background: var(--text); color: var(--white); padding: 12px 16px; border: none; cursor: pointer; position: fixed; top: 0; left: 0; z-index: 100; }
    .bo-table { width: 100%; background: var(--white); border-radius: 12px; overflow: hidden; border: 2px solid var(--border); }
    .bo-table th, .bo-table td { padding: 12px 14px; text-align: left; border-bottom: 1px solid var(--border); }
    .bo-table th { background: var(--gray); font-weight: 700; font-size: 0.8rem; text-transform: uppercase; }
    .bo-table tr:hover { background: var(--gray); }
    .bo-actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .bo-action-btn { padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; cursor: pointer; text-decoration: none; border: none; }
    .bo-action-btn.edit { background: var(--orange-pale); color: var(--orange); }
    .bo-action-btn.delete { background: #fee2e2; color: #dc2626; }
    @media (max-width: 767px) {
      .bo-sidebar { display: none; }
      .bo-sidebar.show { display: block; }
      .bo-main { margin-left: 0; padding: 20px 16px; }
      .bo-toggle { display: block; }
    }
  </style>
</head>
<body>
  <button class="bo-toggle" onclick="document.querySelector('.bo-sidebar').classList.toggle('show')">☰ Menu</button>
  <div class="bo-layout">
    <aside class="bo-sidebar">
      <h2>Backoffice</h2>
      <a href="/backoffice" {{#eq page 'dashboard'}}class="active"{{/eq}}>Dashboard</a>
      <a href="/backoffice/categories" {{#eq page 'categories'}}class="active"{{/eq}}>Categorias</a>
      <a href="/backoffice/blog" {{#eq page 'blog'}}class="active"{{/eq}}>Blog</a>
      <a href="/backoffice/password">Password</a>
      <a href="/backoffice/logout" onclick="return confirm('Cerrar sesion?')">Salir</a>
    </aside>
    <main class="bo-main">
      {{{body}}}
    </main>
  </div>
</body>
</html>