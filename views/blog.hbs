

<section class="page-header">
  <div class="container">
    <h1>Blog</h1>
    <p>{{blogPosts.length}} artículos</p>
  </div>
</section>

<section class="section">
  <div class="container">
    {{#if blogPosts.length}}
    <div class="blog-grid">
      {{#each blogPosts}}
      <a href="/blog/{{id}}" class="blog-card">
        {{#if image}}
        <div class="blog-card-image">
          <img src="/uploads/{{image}}" alt="{{title}}">
        </div>
        {{/if}}
        <div class="blog-content">
          <div class="blog-meta">
            <span class="blog-category">{{category}}</span>
            <span class="blog-date">{{date}}</span>
          </div>
          <h2>{{title}}</h2>
          <p>{{excerpt}}</p>
        </div>
      </a>
      {{/each}}
    </div>
    {{else}}
    <div class="empty-state">
      <h3>Sin publicaciones</h3>
      <p>Aun no hay articulos en el blog. Vuelve pronto!</p>
    </div>
    {{/if}}
  </div>
</section>