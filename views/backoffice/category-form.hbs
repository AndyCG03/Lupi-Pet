<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .bo-layout { display: flex; min-height: 100vh; }
    .bo-sidebar { width: 240px; background: var(--text); color: var(--white); padding: 24px; flex-shrink: 0; }
    .bo-sidebar h2 { color: var(--orange); margin-bottom: 32px; font-size: 1.3rem; }
    .bo-sidebar nav { display: flex; flex-direction: column; gap: 8px; }
    .bo-sidebar a { color: rgba(255,255,255,.7); padding: 12px 16px; border-radius: 8px; transition: all .2s; }
    .bo-sidebar a:hover, .bo-sidebar a.active { background: rgba(255,255,255,.1); color: var(--white); }
    .bo-main { flex: 1; padding: 32px; background: var(--cream); }
    .bo-form { background: var(--white); padding: 32px; border-radius: var(--radius); border: 2px solid var(--border); max-width: 500px; }
    .bo-form h1 { font-size: 1.5rem; margin-bottom: 24px; }
    .bo-form-group { margin-bottom: 20px; }
    .bo-form-group label { display: block; font-weight: 700; margin-bottom: 8px; }
    .bo-form-group input { width: 100%; padding: 12px 16px; border: 2px solid var(--border); border-radius: var(--radius-sm); font-family: 'Baloo 2', cursive; font-size: 1rem; }
    .bo-form-group input:focus { border-color: var(--orange); outline: none; }
    .bo-btn { background: var(--orange); color: var(--white); padding: 12px 24px; border-radius: 50px; font-weight: 700; display: inline-block; border: none; cursor: pointer; }
    .bo-btn:hover { background: var(--orange-dark); }
  </style>
</head>
<body>
  <div class="bo-layout">
    <aside class="bo-sidebar">
      <h2>🐾 Backoffice</h2>
      <nav>
        <a href="/backoffice">Dashboard</a>
        <a href="/backoffice/categories">Categorias</a>
        <a href="/backoffice/blog">Blog</a>
        <a href="/backoffice/logout">Salir</a>
      </nav>
    </aside>
    <main class="bo-main">
      <div class="bo-form">
        <h1>{{#if category.id}}Editar{{else}}Nueva{{/if}} Categoria</h1>
        <form action="{{#if category.id}}/backoffice/categories/{{category.id}}{{else}}/backoffice/categories{{/if}}" method="POST">
          <div class="bo-form-group">
            <label>Nombre</label>
            <input type="text" name="name" value="{{category.name}}" required>
          </div>
          <div class="bo-form-group">
            <label>Slug (URL)</label>
            <input type="text" name="slug" value="{{category.slug}}" required>
          </div>
          <div class="bo-form-group">
            <label>Emoji</label>
            <input type="text" name="emoji" value="{{category.emoji}}">
          </div>
          <button type="submit" class="bo-btn">Guardar</button>
          <a href="/backoffice/categories" class="bo-btn" style="background:var(--gray);color:var(--text)">Cancelar</a>
        </form>
      </div>
    </main>
  </div>
</body>
</html>