<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Baloo 2', cursive; background: #FDF6F0; }
    .bo-layout { display: flex; justify-content: center; align-items: center; padding: 40px 20px; min-height: 100vh; }
    .bo-form { background: #fff; padding: 32px; border-radius: 12px; border: 2px solid #EDD9CA; width: 100%; max-width: 500px; }
    .bo-form h1 { font-size: 1.5rem; margin-bottom: 24px; }
    .bo-form-group { margin-bottom: 20px; }
    .bo-form-group label { display: block; font-weight: 700; margin-bottom: 8px; }
    .bo-form-group input, .bo-form-group select { width: 100%; padding: 12px 16px; border: 2px solid #EDD9CA; border-radius: 8px; font-family: 'Baloo 2', cursive; font-size: 1rem; box-sizing: border-box; }
    .bo-form-group input:focus, .bo-form-group select:focus { border-color: #EE5804; outline: none; }
    .bo-btn { background: #EE5804; color: #fff; padding: 12px 24px; border-radius: 50px; font-weight: 700; display: inline-block; border: none; cursor: pointer; text-decoration: none; font-family: 'Baloo 2', cursive; }
    .bo-btn:hover { background: #C44500; }
    .bo-btn-secondary { background: #E8DFD4; color: #2D1A0E; }
  </style>
</head>
<body>
  <div class="bo-layout">
    <div class="bo-form">
      <h1>{{#if category.id}}Editar{{else}}Nueva{{/if}} Categoria</h1>
      <form action="{{#if category.id}}/backoffice/categories/{{category.id}}{{else}}/backoffice/categories{{/if}}" method="POST">
        <div class="bo-form-group">
          <label>Nombre</label>
          <input type="text" name="name" value="{{category.name}}" placeholder="Ej: Alimentos" required>
        </div>
        <div class="bo-form-group">
          <label>Slug (URL)</label>
          <input type="text" name="slug" value="{{category.slug}}" placeholder="Ej: alimentos" required>
        </div>
        <div class="bo-form-group">
          <label>Para mascotas</label>
          <select name="pet" required>
            <option value="ambos" {{#eq category.pet 'ambos'}}selected{{/eq}}>Ambos</option>
            <option value="perro" {{#eq category.pet 'perro'}}selected{{/eq}}>Solo perros</option>
            <option value="gato" {{#eq category.pet 'gato'}}selected{{/eq}}>Solo gatos</option>
          </select>
        </div>
        <button type="submit" class="bo-btn">Guardar</button>
        <a href="/backoffice/categories" class="bo-btn bo-btn-secondary">Cancelar</a>
      </form>
    </div>
  </div>
</body>
</html>