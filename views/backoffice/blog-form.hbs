<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Baloo 2', cursive; background: #FDF6F0; }
    .bo-layout { display: flex; justify-content: center; padding: 40px 20px; min-height: 100vh; }
    .bo-form { background: #fff; padding: 32px; border-radius: 12px; border: 2px solid #EDD9CA; width: 100%; max-width: 700px; }
    .bo-form h1 { font-size: 1.5rem; margin-bottom: 24px; }
    .bo-form-group { margin-bottom: 20px; }
    .bo-form-group label { display: block; font-weight: 700; margin-bottom: 8px; }
    .bo-form-group input, .bo-form-group select, .bo-form-group textarea { 
      width: 100%; padding: 12px 16px; border: 2px solid #EDD9CA; border-radius: 8px; 
      font-family: 'Baloo 2', cursive; font-size: 1rem; box-sizing: border-box; 
    }
    .bo-form-group input:focus, .bo-form-group select:focus, .bo-form-group textarea:focus { border-color: #EE5804; outline: none; }
    .bo-form-group textarea { min-height: 120px; resize: vertical; }
    .bo-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .bo-btn { background: #EE5804; color: #fff; padding: 12px 24px; border-radius: 50px; font-weight: 700; display: inline-block; border: none; cursor: pointer; text-decoration: none; font-family: 'Baloo 2', cursive; }
    .bo-btn:hover { background: #C44500; }
    .bo-btn-secondary { background: #E8DFD4; color: #2D1A0E; }
    .image-preview-container { margin-top: 12px; }
    .image-preview { 
      width: 150px; height: 150px; object-fit: cover; border-radius: 10px; 
      border: 2px dashed #EDD9CA; display: none; 
    }
    .image-preview.has-image { display: block; border-style: solid; }
    .image-placeholder {
      width: 150px; height: 150px; background: #E8DFD4; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      color: #666; font-size: 0.85rem;
    }
    @media (max-width: 600px) {
      .bo-form-row { grid-template-columns: 1fr; }
      .bo-form { padding: 20px; }
    }
  </style>
</head>
<body>
  <div class="bo-layout">
    <div class="bo-form">
      <h1>{{#if post.id}}Editar{{else}}Nueva{{/if}} Entrada</h1>
      <form action="{{#if post.id}}/backoffice/blog/{{post.id}}{{else}}/backoffice/blog{{/if}}" method="POST" enctype="multipart/form-data">
        {{#if post.id}}
        <input type="hidden" name="existing_image" value="{{post.image}}">
        {{/if}}
        <div class="bo-form-group">
          <label>Titulo</label>
          <input type="text" name="title" value="{{post.title}}" placeholder="Titulo del articulo" required>
        </div>
        <div class="bo-form-row">
          <div class="bo-form-group">
            <label>Categoria</label>
            <select name="category" required>
              <option value="Bienestar" {{#eq post.category 'Bienestar'}}selected{{/eq}}>Bienestar</option>
              <option value="Nutricion" {{#eq post.category 'Nutricion'}}selected{{/eq}}>Nutricion</option>
              <option value="Salud" {{#eq post.category 'Salud'}}selected{{/eq}}>Salud</option>
              <option value="Consejos" {{#eq post.category 'Consejos'}}selected{{/eq}}>Consejos</option>
              <option value="Entrenamiento" {{#eq post.category 'Entrenamiento'}}selected{{/eq}}>Entrenamiento</option>
            </select>
          </div>
          <div class="bo-form-group">
            <label>Para mascotas</label>
            <select name="pet" required>
              <option value="perro" {{#eq post.pet 'perro'}}selected{{/eq}}>Perro</option>
              <option value="gato" {{#eq post.pet 'gato'}}selected{{/eq}}>Gato</option>
              <option value="ambos" {{#eq post.pet 'ambos'}}selected{{/eq}}>Ambos</option>
            </select>
          </div>
        </div>
        <div class="bo-form-group">
          <label>Imagen</label>
          <input type="file" name="image" accept="image/*" id="imageInput">
          <div class="image-preview-container">
            {{#if post.image}}
            <img src="/uploads/{{post.image}}" class="image-preview has-image" id="imagePreview">
            {{else}}
            <div class="image-placeholder" id="imagePlaceholder">Sin imagen</div>
            <img src="" class="image-preview" id="imagePreview">
            {{/if}}
          </div>
        </div>
        <div class="bo-form-group">
          <label>Extracto</label>
          <textarea name="excerpt" placeholder="Resumen corto del articulo...">{{post.excerpt}}</textarea>
        </div>
        <div class="bo-form-group">
          <label>Contenido</label>
          <textarea name="content" placeholder="Contenido del articulo...">{{post.content}}</textarea>
        </div>
        <button type="submit" class="bo-btn">Guardar</button>
        <a href="/backoffice/blog" class="bo-btn bo-btn-secondary">Cancelar</a>
      </form>
    </div>
  </div>
  <script>
    document.getElementById('imageInput').addEventListener('change', function(e) {
      const file = e.target.files[0];
      const preview = document.getElementById('imagePreview');
      const placeholder = document.getElementById('imagePlaceholder');
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) { preview.src = e.target.result; preview.classList.add('has-image'); if (placeholder) placeholder.style.display = 'none'; };
        reader.readAsDataURL(file);
      }
    });
  </script>
</body>
</html>