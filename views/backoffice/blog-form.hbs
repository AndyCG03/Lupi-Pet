<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .bo-layout { display: flex; min-height: 100vh; }
    .bo-sidebar { width: 240px; background: var(--text); color: var(--white); padding: 24px; flex-shrink: 0; }
    .bo-sidebar h2 { color: var(--orange); margin-bottom: 32px; font-size: 1.3rem; }
    .bo-sidebar nav { display: flex; flex-direction: column; gap: 8px; }
    .bo-sidebar a { color: rgba(255,255,255,.7); padding: 12px 16px; border-radius: 8px; transition: all .2s; }
    .bo-sidebar a:hover, .bo-sidebar a.active { background: rgba(255,255,255,.1); color: var(--white); }
    .bo-main { flex: 1; padding: 32px; background: var(--cream); }
    .bo-form { background: var(--white); padding: 32px; border-radius: var(--radius); border: 2px solid var(--border); max-width: 700px; }
    .bo-form h1 { font-size: 1.5rem; margin-bottom: 24px; }
    .bo-form-group { margin-bottom: 20px; }
    .bo-form-group label { display: block; font-weight: 700; margin-bottom: 8px; }
    .bo-form-group input, .bo-form-group select, .bo-form-group textarea { width: 100%; padding: 12px 16px; border: 2px solid var(--border); border-radius: var(--radius-sm); font-family: 'Baloo 2', cursive; font-size: 1rem; }
    .bo-form-group input:focus, .bo-form-group select:focus, .bo-form-group textarea:focus { border-color: var(--orange); outline: none; }
    .bo-form-group textarea { min-height: 150px; resize: vertical; }
    .bo-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .bo-btn { background: var(--orange); color: var(--white); padding: 12px 24px; border-radius: 50px; font-weight: 700; display: inline-block; border: none; cursor: pointer; }
    .bo-btn:hover { background: var(--orange-dark); }
    .bo-btn-secondary { background: var(--gray); color: var(--text); }
  </style>
</head>
<body>
  <div class="bo-layout">
    <aside class="bo-sidebar">
      <h2>🐾 Backoffice</h2>
      <nav>
        <a href="/backoffice">Dashboard</a>
        <a href="/backoffice/categories">Categorias</a>
        <a href="/backoffice/blog">Blog</a>
        <a href="/backoffice/logout">Salir</a>
      </nav>
    </aside>
    <main class="bo-main">
      <div class="bo-form">
        <h1>{{#if post.id}}Editar{{else}}Nueva{{/if}} Entrada</h1>
        <form action="{{#if post.id}}/backoffice/blog/{{post.id}}{{else}}/backoffice/blog{{/if}}" method="POST">
          <div class="bo-form-group">
            <label>Titulo</label>
            <input type="text" name="title" value="{{post.title}}" required>
          </div>
          <div class="bo-form-row">
            <div class="bo-form-group">
              <label>Categoria</label>
              <select name="category" required>
                <option value="Bienestar" {{#eq post.category 'Bienestar'}}selected{{/eq}}>Bienestar</option>
                <option value="Nutricion" {{#eq post.category 'Nutricion'}}selected{{/eq}}>Nutricion</option>
                <option value="Salud" {{#eq post.category 'Salud'}}selected{{/eq}}>Salud</option>
                <option value="Entrenamiento" {{#eq post.category 'Entrenamiento'}}selected{{/eq}}>Entrenamiento</option>
              </select>
            </div>
            <div class="bo-form-group">
              <label>Para</label>
              <select name="pet" required>
                <option value="perro" {{#eq post.pet 'perro'}}selected{{/eq}}>Perro</option>
                <option value="gato" {{#eq post.pet 'gato'}}selected{{/eq}}>Gato</option>
                <option value="ambos" {{#eq post.pet 'ambos'}}selected{{/eq}}>Ambos</option>
              </select>
            </div>
          </div>
          <div class="bo-form-row">
            <div class="bo-form-group">
              <label>Emoji</label>
              <input type="text" name="emoji" value="{{post.emoji}}">
            </div>
            <div class="bo-form-group">
              <label>Fecha</label>
              <input type="text" name="date" value="{{post.date}}" placeholder="28 Abr 2025">
            </div>
          </div>
          <div class="bo-form-group">
            <label>Extracto</label>
            <textarea name="excerpt">{{post.excerpt}}</textarea>
          </div>
          <div class="bo-form-group">
            <label>Contenido</label>
            <textarea name="content">{{post.content}}</textarea>
          </div>
          <div class="bo-form-group">
            <label>Tiempo de lectura</label>
            <input type="text" name="read_time" value="{{post.read_time}}" placeholder="4 min">
          </div>
          <button type="submit" class="bo-btn">Guardar</button>
          <a href="/backoffice/blog" class="bo-btn bo-btn-secondary">Cancelar</a>
        </form>
      </div>
    </main>
  </div>
</body>
</html>