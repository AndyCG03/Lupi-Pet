<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .bo-layout { display: flex; min-height: 100vh; }
    .bo-sidebar { width: 240px; background: var(--text); color: var(--white); padding: 24px; flex-shrink: 0; }
    .bo-sidebar h2 { color: var(--orange); margin-bottom: 32px; font-size: 1.3rem; }
    .bo-sidebar nav { display: flex; flex-direction: column; gap: 8px; }
    .bo-sidebar a { color: rgba(255,255,255,.7); padding: 12px 16px; border-radius: 8px; transition: all .2s; }
    .bo-sidebar a:hover, .bo-sidebar a.active { background: rgba(255,255,255,.1); color: var(--white); }
    .bo-main { flex: 1; padding: 32px; background: var(--cream); }
    .bo-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; }
    .bo-header h1 { font-size: 1.8rem; font-weight: 800; }
    .bo-btn { background: var(--orange); color: var(--white); padding: 10px 20px; border-radius: 50px; font-weight: 700; display: inline-block; }
    .bo-btn:hover { background: var(--orange-dark); }
    .bo-table { width: 100%; background: var(--white); border-radius: var(--radius); overflow: hidden; border: 2px solid var(--border); }
    .bo-table th, .bo-table td { padding: 14px 16px; text-align: left; border-bottom: 1px solid var(--border); }
    .bo-table th { background: var(--gray); font-weight: 700; font-size: 0.85rem; text-transform: uppercase; }
    .bo-table tr:hover { background: var(--gray); }
    .bo-actions { display: flex; gap: 8px; }
    .bo-action-btn { padding: 6px 12px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer; }
    .bo-edit { background: var(--orange-pale); color: var(--orange); border: none; }
    .bo-delete { background: #fee2e2; color: #dc2626; border: none; }
    .bo-card { background: var(--white); border-radius: var(--radius); padding: 24px; border: 2px solid var(--border); }
    .bo-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 32px; }
    .bo-stat { background: var(--white); border-radius: var(--radius-sm); padding: 20px; border: 2px solid var(--border); text-align: center; }
    .bo-stat strong { display: block; font-size: 1.8rem; color: var(--orange); }
    .bo-stat span { font-size: 0.85rem; color: var(--text-light); }
  </style>
</head>
<body>
  <div class="bo-layout">
    <aside class="bo-sidebar">
      <h2>🐾 Backoffice</h2>
      <nav>
        <a href="/backoffice" class="{{#eq page 'backoffice'}}active{{/eq}}">Dashboard</a>
        <a href="/backoffice" class="{{#eq page 'products'}}active{{/eq}}">Productos</a>
        <a href="/backoffice/categories" class="{{#eq page 'categories'}}active{{/eq}}">Categorias</a>
        <a href="/backoffice/blog" class="{{#eq page 'blog'}}active{{/eq}}">Blog</a>
        <a href="/backoffice/password">Cambiar Contrasena</a>
        <a href="/backoffice/logout">Salir</a>
      </nav>
    </aside>
    <main class="bo-main">
      <div class="bo-header">
        <h1>Dashboard</h1>
        <a href="/backoffice/products/new" class="bo-btn">+ Nuevo Producto</a>
      </div>

      <div class="bo-stats">
        <div class="bo-stat"><strong>{{productCount}}</strong><span>Productos</span></div>
        <div class="bo-stat"><strong>{{categoryCount}}</strong><span>Categorias</span></div>
        <div class="bo-stat"><strong>{{blogCount}}</strong><span>Blog</span></div>
        <div class="bo-stat" style="background:{{#if lowStock}}#fee2e2{{else}}#d1fae5{{/if}}"><strong>{{lowStock}}</strong><span>Stock bajo</span></div>
      </div>

      <div class="bo-header" style="margin-top:32px">
        <h1>Gestion de Productos</h1>
      <table class="bo-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Categoria</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Imagen</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          {{#each products}}
          <tr>
            <td>{{id}}</td>
            <td>{{name}}</td>
            <td>{{category_name}}</td>
            <td>${{price}}</td>
            <td>{{stock}}</td>
            <td>{{#if image}}<img src="/uploads/{{image}}" width="50">{{else}}<span style="color:#999">Sin imagen</span>{{/if}}</td>
            <td>
              <div class="bo-actions">
                <a href="/backoffice/products/{{id}}/edit" class="bo-action-btn bo-edit">Editar</a>
                <form action="/backoffice/products/{{id}}/delete" method="POST" style="display:inline">
                  <button type="submit" class="bo-action-btn bo-delete" onclick="return confirm('Eliminar producto?')">Eliminar</button>
                </form>
              </div>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </main>
  </div>
</body>
</html>