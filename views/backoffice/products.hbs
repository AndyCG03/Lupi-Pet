<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Baloo 2', cursive; background: #FDF6F0; }
    .bo-layout { display: flex; min-height: 100vh; }
    .bo-sidebar { width: 240px; background: #2D1A0E; color: #fff; padding: 24px; flex-shrink: 0; position: fixed; height: 100vh; left: 0; top: 0; overflow-y: auto; }
    .bo-sidebar h2 { color: #EE5804; margin: 0 0 24px 0; font-size: 1.3rem; }
    .bo-sidebar a { display: block; color: rgba(255,255,255,.7); padding: 12px 16px; border-radius: 8px; transition: all .2s; margin-bottom: 4px; text-decoration: none; }
    .bo-sidebar a:hover, .bo-sidebar a.active { background: rgba(255,255,255,.1); color: #fff; }
    .bo-main { flex: 1; margin-left: 240px; padding: 32px; background: #FDF6F0; min-height: 100vh; width: calc(100% - 240px); }
    .bo-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px; }
    .bo-header h1 { font-size: 1.8rem; font-weight: 800; margin: 0; }
    .bo-btn { background: #EE5804; color: #fff; padding: 10px 20px; border-radius: 50px; font-weight: 700; display: inline-block; text-decoration: none; transition: all .2s; border: none; cursor: pointer; font-family: 'Baloo 2', cursive; }
    .bo-btn:hover { background: #C44500; }
    .bo-toggle { display: none; background: #2D1A0E; color: #fff; padding: 12px 16px; border: none; cursor: pointer; position: fixed; top: 0; left: 0; z-index: 100; }
    .bo-table { width: 100%; background: #fff; border-radius: 12px; overflow: hidden; border: 2px solid #EDD9CA; }
    .bo-table th, .bo-table td { padding: 12px 14px; text-align: left; border-bottom: 1px solid #EDD9CA; }
    .bo-table th { background: #E8DFD4; font-weight: 700; font-size: 0.8rem; text-transform: uppercase; }
    .bo-table tr:hover { background: #FDF6F0; }
    .bo-actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .bo-action-btn { padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; cursor: pointer; text-decoration: none; border: none; }
    .bo-action-btn.edit { background: #FEE4D6; color: #EE5804; }
    .bo-action-btn.delete { background: #fee2e2; color: #dc2626; }
    .dialog-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 200; justify-content: center; align-items: center; }
    .dialog-overlay.show { display: flex; }
    .dialog { background: #fff; border-radius: 12px; padding: 24px; max-width: 600px; width: 90%; max-height: 90vh; overflow-y: auto; }
    .dialog h2 { margin: 0 0 20px 0; font-size: 1.5rem; }
    .dialog-close { background: none; border: none; font-size: 1.5rem; cursor: pointer; float: right; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-weight: 700; margin-bottom: 6px; }
    .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 10px 12px; border: 2px solid #EDD9CA; border-radius: 8px; font-family: 'Baloo 2', cursive; font-size: 1rem; }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: #EE5804; outline: none; }
    .checkbox-label { display: flex; align-items: center; gap: 8px; font-weight: 600; cursor: pointer; }
    .checkbox-label input { width: 18px; height: 18px; accent-color: #EE5804; }
    .form-row { display: flex; gap: 12px; }
    .form-row .form-group { flex: 1; }
    @media (max-width: 767px) {
      .bo-sidebar { display: none; }
      .bo-sidebar.show { display: block; }
      .bo-main { margin-left: 0; padding: 20px 16px; width: 100%; }
      .bo-toggle { display: block; }
      .form-row { flex-direction: column; }
      .bo-table { display: block; overflow-x: auto; }
    }
  </style>
</head>
<body>
  <button class="bo-toggle" onclick="document.querySelector('.bo-sidebar').classList.toggle('show')">☰ Menu</button>
  <div class="bo-layout">
    <aside class="bo-sidebar">
      <h2>Backoffice</h2>
      <a href="/backoffice/products" {{#eq page 'products'}}class="active"{{/eq}}>Productos</a>
      <a href="/backoffice/categories" {{#eq page 'categories'}}class="active"{{/eq}}>Categorías</a>
      <a href="/backoffice/pets" {{#eq page 'pets'}}class="active"{{/eq}}>Mascotas</a>
      <a href="/backoffice/blog" {{#eq page 'blog'}}class="active"{{/eq}}>Blog</a>
      <a href="/backoffice/password" {{#eq page 'password'}}class="active"{{/eq}}>Contraseña</a>
      <a href="/backoffice/logout" onclick="return confirm('Cerrar sesion?')">Salir</a>
    </aside>
    <main class="bo-main">
      <div class="bo-header">
        <h1>Productos</h1>
        <button class="bo-btn" onclick="document.getElementById('productDialog').classList.add('show')">+ Nuevo Producto</button>
      </div>
      <table class="bo-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Categoria</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Para</th>
            <th>Destacado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          {{#each products}}
          <tr>
            <td>{{id}}</td>
            <td>{{name}}</td>
            <td>{{category_name}}</td>
            <td>${{price}}</td>
            <td>{{#eq stock 'sin-stock'}}Sin stock{{else}}{{#eq stock 'pocos'}}Pocos{{else}}Muchos{{/eq}}{{/eq}}</td>
            <td>{{#eq pet 'ambos'}}Ambos{{else}}{{pet_name}}{{/eq}}</td>
            <td>{{#eq featured 1}}Si{{else}}No{{/eq}}</td>
            <td>
              <div class="bo-actions">
                <a href="/backoffice/products/{{id}}/edit" class="bo-action-btn edit">Editar</a>
                <form action="/backoffice/products/{{id}}/delete" method="POST" style="display:inline">
                  <button type="submit" class="bo-action-btn delete" onclick="return confirm('Eliminar?')">X</button>
                </form>
              </div>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="8" style="text-align:center;padding:40px;">No hay productos</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </main>
  </div>

  <div class="dialog-overlay" id="productDialog">
    <div class="dialog">
      <button class="dialog-close" onclick="document.getElementById('productDialog').classList.remove('show')">&times;</button>
      <h2>Nuevo Producto</h2>
      <form action="/backoffice/products" method="POST" enctype="multipart/form-data" id="productForm">
        <div class="form-group">
          <label>Nombre</label>
          <input type="text" name="name" placeholder="Nombre del producto" required>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Categoria</label>
            <select name="category_id" required>
              {{#each categories}}
              <option value="{{id}}">{{name}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-group">
            <label>Para</label>
            <select name="pet" required>
              <option value="ambos">Ambos</option>
              {{#each pets}}
              <option value="{{slug}}">{{name}}</option>
              {{/each}}
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Precio (MXN)</label>
            <input type="number" name="price" step="0.01" placeholder="0.00" required>
          </div>
          <div class="form-group">
            <label>Stock</label>
            <select name="stock">
              <option value="muchos" {{#eq stock 'muchos'}}selected{{/eq}}>Muchos</option>
              <option value="pocos" {{#eq stock 'pocos'}}selected{{/eq}}>Pocos</option>
              <option value="sin-stock" {{#eq stock 'sin-stock'}}selected{{/eq}}>Sin stock</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>Imagen</label>
          <input type="file" name="image" accept="image/*">
        </div>
        <div class="form-group">
          <label>Descripcion</label>
          <textarea name="description" rows="3" placeholder="Descripcion del producto"></textarea>
        </div>
        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" name="featured" value="1"> Producto destacado (aparece en home)
          </label>
        </div>
        <button type="submit" class="bo-btn">Guardar</button>
      </form>
    </div>
  </div>
</body>
</html>