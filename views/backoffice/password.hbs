<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Baloo 2', cursive; background: #FDF6F0; }
    .bo-layout { display: flex; min-height: 100vh; }
    .bo-sidebar { width: 240px; background: #2D1A0E; color: #fff; padding: 24px; flex-shrink: 0; position: fixed; height: 100vh; left: 0; top: 0; overflow-y: auto; }
    .bo-sidebar h2 { color: #EE5804; margin: 0 0 24px 0; font-size: 1.3rem; }
    .bo-sidebar a { display: block; color: rgba(255,255,255,.7); padding: 12px 16px; border-radius: 8px; transition: all .2s; margin-bottom: 4px; text-decoration: none; }
    .bo-sidebar a:hover, .bo-sidebar a.active { background: rgba(255,255,255,.1); color: #fff; }
    .bo-main { flex: 1; margin-left: 240px; padding: 32px; background: #FDF6F0; min-height: 100vh; width: calc(100% - 240px); }
    .bo-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px; }
    .bo-header h1 { font-size: 1.8rem; font-weight: 800; margin: 0; }
    .bo-toggle { display: none; background: #2D1A0E; color: #fff; padding: 12px 16px; border: none; cursor: pointer; position: fixed; top: 0; left: 0; z-index: 100; }
    .pass-form { background: #fff; padding: 32px; border-radius: 18px; border: 2px solid #EDD9CA; max-width: 400px; }
    .pass-form h1 { font-size: 1.5rem; margin-bottom: 24px; }
    .pass-form-group { margin-bottom: 20px; }
    .pass-form-group label { display: block; font-weight: 700; margin-bottom: 8px; }
    .pass-form-group input { width: 100%; padding: 12px 16px; border: 2px solid #EDD9CA; border-radius: 10px; font-family: 'Baloo 2', cursive; font-size: 1rem; background: #F5EDE6; }
    .pass-form-group input:focus { border-color: #EE5804; outline: none; background: #fff; }
    .pass-form button { background: #EE5804; color: #fff; padding: 12px 24px; border-radius: 50px; font-weight: 700; border: none; cursor: pointer; font-family: 'Baloo 2', cursive; }
    .pass-form button:hover { background: #C44500; }
    .pass-form a { display: inline-block; margin-left: 12px; color: #EE5804; }
    .error { color: #dc2626; font-size: 0.9rem; margin-bottom: 16px; }
    .success { color: #16a34a; font-size: 0.9rem; margin-bottom: 16px; }
    @media (max-width: 767px) {
      .bo-sidebar { display: none; }
      .bo-sidebar.show { display: block; }
      .bo-main { margin-left: 0; padding: 20px 16px; width: 100%; }
      .bo-toggle { display: block; }
    }
  </style>
</head>
<body>
  <button class="bo-toggle" onclick="document.querySelector('.bo-sidebar').classList.toggle('show')">☰ Menu</button>
  <div class="bo-layout">
    <aside class="bo-sidebar">
      <h2>Backoffice</h2>
      <a href="/backoffice/products" {{#eq page 'products'}}class="active"{{/eq}}>Productos</a>
      <a href="/backoffice/categories" {{#eq page 'categories'}}class="active"{{/eq}}>Categorias</a>
      <a href="/backoffice/blog" {{#eq page 'blog'}}class="active"{{/eq}}>Blog</a>
      <a href="/backoffice/password" {{#eq page 'password'}}class="active"{{/eq}}>Password</a>
      <a href="/backoffice/logout" onclick="return confirm('Cerrar sesion?')">Salir</a>
    </aside>
    <main class="bo-main">
      <div class="pass-form">
        <h1>Cambiar Contrasena</h1>
        {{#if error}}
        <p class="error">{{error}}</p>
        {{/if}}
        {{#if success}}
        <p class="success">{{success}}</p>
        {{/if}}
        <form action="/backoffice/password" method="POST">
          <div class="pass-form-group">
            <label>Contrasena Actual</label>
            <input type="password" name="current_password" required>
          </div>
          <div class="pass-form-group">
            <label>Nueva Contrasena</label>
            <input type="password" name="new_password" required minlength="4">
          </div>
          <div class="pass-form-group">
            <label>Confirmar Nueva Contrasena</label>
            <input type="password" name="confirm_password" required minlength="4">
          </div>
          <button type="submit">Guardar</button>
          <a href="/backoffice/products">Cancelar</a>
        </form>
      </div>
    </main>
  </div>
</body>
</html>