<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Baloo 2', cursive; background: #FDF6F0; }
    .bo-layout { display: flex; min-height: 100vh; }
    .bo-sidebar { width: 240px; background: #2D1A0E; color: #fff; padding: 24px; flex-shrink: 0; position: fixed; height: 100vh; left: 0; top: 0; overflow-y: auto; }
    .bo-sidebar h2 { color: #EE5804; margin: 0 0 24px 0; font-size: 1.3rem; }
    .bo-sidebar a { display: block; color: rgba(255,255,255,.7); padding: 12px 16px; border-radius: 8px; transition: all .2s; margin-bottom: 4px; text-decoration: none; }
    .bo-sidebar a:hover, .bo-sidebar a.active { background: rgba(255,255,255,.1); color: #fff; }
    .bo-main { flex: 1; margin-left: 240px; padding: 32px; background: #FDF6F0; min-height: 100vh; width: calc(100% - 240px); }
    .bo-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px; }
    .bo-header h1 { font-size: 1.8rem; font-weight: 800; margin: 0; }
    .bo-btn { background: #EE5804; color: #fff; padding: 12px 20px; border-radius: 50px; font-weight: 700; border: none; cursor: pointer; font-family: 'Baloo 2', cursive; font-size: 1rem; }
    .bo-btn:hover { background: #C44500; }
    .bo-table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 12px; overflow: hidden; border: 2px solid #EDD9CA; }
    .bo-table th { background: #2D1A0E; color: #fff; padding: 14px 16px; text-align: left; font-weight: 600; }
    .bo-table td { padding: 14px 16px; border-bottom: 1px solid #EDD9CA; }
    .bo-table tr:hover { background: #FAF5EF; }
    .bo-actions { display: flex; gap: 6px; }
    .bo-action-btn { padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; cursor: pointer; text-decoration: none; border: none; }
    .bo-action-btn.edit { background: #FEE4D6; color: #EE5804; }
    .bo-action-btn.delete { background: #fee2e2; color: #dc2626; }
    .bo-toggle { display: none; background: #2D1A0E; color: #fff; padding: 12px 16px; border: none; cursor: pointer; position: fixed; top: 0; left: 0; z-index: 100; }
    .dialog-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.5); z-index: 200; align-items: center; justify-content: center; }
    .dialog-overlay.show { display: flex; }
    .dialog { background: #fff; border-radius: 18px; padding: 28px; width: 100%; max-width: 480px; max-height: 90vh; overflow-y: auto; position: relative; }
    .dialog h2 { margin: 0 0 20px 0; font-size: 1.5rem; }
    .dialog-close { background: none; border: none; font-size: 1.5rem; cursor: pointer; float: right; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-weight: 700; margin-bottom: 6px; }
    .form-group input, .form-group select { width: 100%; padding: 10px 12px; border: 2px solid #EDD9CA; border-radius: 8px; font-family: 'Baloo 2', cursive; font-size: 1rem; }
    .form-group input:focus, .form-group select:focus { border-color: #EE5804; outline: none; }
    .form-row { display: flex; gap: 12px; }
    .form-row .form-group { flex: 1; }
    @media (max-width: 767px) {
      .bo-sidebar { display: none; }
      .bo-sidebar.show { display: block; }
      .bo-main { margin-left: 0; padding: 20px 16px; width: 100%; }
      .bo-toggle { display: block; }
      .bo-table { display: block; overflow-x: auto; }
      .form-row { flex-direction: column; }
    }
  </style>
</head>
<body>
  <button class="bo-toggle" onclick="document.querySelector('.bo-sidebar').classList.toggle('show')">☰ Menú</button>
  <div class="bo-layout">
    <aside class="bo-sidebar">
      <h2>Backoffice</h2>
      <a href="/backoffice/products" {{#eq page 'products'}}class="active"{{/eq}}>Productos</a>
      <a href="/backoffice/categories" {{#eq page 'categories'}}class="active"{{/eq}}>Categorías</a>
      <a href="/backoffice/pets" {{#eq page 'pets'}}class="active"{{/eq}}>Mascotas</a>
      <a href="/backoffice/blog" {{#eq page 'blog'}}class="active"{{/eq}}>Blog</a>
      <a href="/backoffice/password" {{#eq page 'password'}}class="active"{{/eq}}>Contraseña</a>
      <a href="/backoffice/logout" onclick="return confirm('Cerrar sesión?')">Salir</a>
    </aside>
    <main class="bo-main">
      <div class="bo-header">
        <h1>Mascotas</h1>
        <button class="bo-btn" onclick="document.getElementById('petDialog').classList.add('show')">+ Nueva Mascota</button>
      </div>
      <table class="bo-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Slug</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          {{#each pets}}
          <tr>
            <td>{{id}}</td>
            <td>{{name}}</td>
            <td>{{slug}}</td>
            <td>
              <div class="bo-actions">
                <a href="/backoffice/pets/{{id}}/edit" class="bo-action-btn edit">Editar</a>
                <form action="/backoffice/pets/{{id}}/delete" method="POST" style="display:inline">
                  <button type="submit" class="bo-action-btn delete" onclick="return confirm('Eliminar?')">X</button>
                </form>
              </div>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="4" style="text-align:center;padding:40px;">No hay mascotas</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </main>
  </div>

  <div class="dialog-overlay" id="petDialog">
    <div class="dialog">
      <button class="dialog-close" onclick="document.getElementById('petDialog').classList.remove('show')">&times;</button>
      <h2>Nueva Mascota</h2>
      <form action="/backoffice/pets" method="POST" id="petForm">
        <div class="form-group">
          <label>Nombre</label>
          <input type="text" name="name" placeholder="Ej: Perro" required>
        </div>
        <div class="form-group">
          <label>Slug (URL)</label>
          <input type="text" name="slug" placeholder="Ej: perro" required>
        </div>
        <button type="submit" class="bo-btn">Guardar</button>
      </form>
    </div>
  </div>
</body>
</html>