<!-- ═══════════════════════════════════
     BLOG PREVIEW
═══════════════════════════════════ -->
<section class="section blog-section">
  <div class="container">
    <div class="section-header">
      <div>
        <p class="section-eyebrow">Consejos y cuidados</p>
        <h2>Del blog</h2>
      </div>
      <a href="/blog" class="see-all">Ver todo →</a>
    </div>

    <div class="blog-grid">
      {{#each blogPosts}}
      <a href="/blog/{{id}}" class="blog-card blog-card-link">
        {{#if image}}
          <div class="blog-card-img-wrap">
            <img src="/uploads/{{image}}" alt="{{title}}" class="blog-card-img">
          </div>
        {{else}}
          <div class="blog-card-img-placeholder">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#EDD9CA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </div>
        {{/if}}
        <div class="blog-card-body">
          <div class="blog-meta">
            <span class="blog-category">{{category}}</span>
            <span class="blog-date">{{date}}</span>
          </div>
          <h3>{{title}}</h3>
          <p>{{excerpt}}</p>
          <span class="blog-read-link">Leer artículo →</span>
        </div>
      </a>
      {{/each}}
    </div>
  </div>
</section>