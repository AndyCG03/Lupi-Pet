<!-- HERO -->
<section class="hero">
  <div class="hero-content">
    <div class="hero-badge">Tienda de mascotas</div>
    <h1>Todo lo que tu<br><span>mascota necesita</span></h1>
    <p>Alimentos, accesorios e higiene de calidad para perros y gatos. Pedidos por WhatsApp con envio a domicilio.</p>
    <div class="hero-cta">
      <a href="/tienda" class="btn-primary">Ver productos</a>
      <a href="https://wa.me/5215512345678" class="btn-outline" target="_blank">Contactanos</a>
    </div>
    <div class="hero-stats">
      <div class="stat"><strong>+200</strong><span>Productos</span></div>
      <div class="stat-divider"></div>
      <div class="stat"><strong>98%</strong><span>Clientes felices</span></div>
      <div class="stat-divider"></div>
      <div class="stat"><strong>24h</strong><span>Envio</span></div>
    </div>
  </div>
  <div class="hero-visual">
    <div class="hero-blob"></div>
    <div class="hero-animal">
      <div class="animal-card">
        <span class="animal-big">🐶</span>
        <div class="animal-bubble">Hola!</div>
      </div>
      <div class="animal-card animal-card-2">
        <span class="animal-big">🐱</span>
        <div class="animal-bubble animal-bubble-2">Miau</div>
      </div>
    </div>
  </div>
</section>

<!-- CATEGORIAS -->
<section class="section categories-section">
  <div class="container">
    <div class="section-header">
      <h2>Encuentra lo que buscas</h2>
      <p>Productos para perros y gatos</p>
    </div>
    <div class="categories-grid">
      <a href="/tienda?categoria=alimentos" class="category-card cat-food">
        <h3>Alimentos</h3>
        <p>Nutricion de calidad</p>
        <span class="cat-arrow">--></span>
      </a>
      <a href="/tienda?categoria=accesorios" class="category-card cat-toys">
        <h3>Accesorios</h3>
        <p>Juguetes y mas</p>
        <span class="cat-arrow">--></span>
      </a>
      <a href="/tienda?categoria=higiene" class="category-card cat-hygiene">
        <h3>Higiene</h3>
        <p>Cuidado y limpieza</p>
        <span class="cat-arrow">--></span>
      </a>
      <a href="/tienda?mascota=perro" class="category-card cat-dog">
        <h3>Para Perros</h3>
        <p>Todo para tu can</p>
        <span class="cat-arrow">--></span>
      </a>
      <a href="/tienda?mascota=gato" class="category-card cat-cat">
        <h3>Para Gatos</h3>
        <p>Lo mejor para tu michi</p>
        <span class="cat-arrow">--></span>
      </a>
    </div>
  </div>
</section>

<!-- PRODUCTOS DESTACADOS -->
<section class="section featured-section">
  <div class="container">
    <div class="section-header">
      <h2>Productos destacados</h2>
      <a href="/tienda" class="see-all">Ver todo --></a>
    </div>
    <div class="products-grid">
      {{#each products}}
      <a href="/producto/{{id}}" class="product-card">
        {{#if badge}}<span class="product-badge">{{badge}}</span>{{/if}}
        <div class="product-image">
          {{#if image}}
          <img src="/uploads/{{image}}" alt="{{name}}">
          {{else}}
          <div class="product-emoji">Imagen no disponible</div>
          {{/if}}
        </div>
<div class="product-info">
            <span class="product-pet">{{#eq pet 'ambos'}}Ambos{{else}}{{pet}}{{/eq}}</span>
            <h3>{{name}}</h3>
          <p>{{description}}</p>
          <div class="product-footer">
            <span class="product-price">${{price}} <small>MXN</small></span>
            <button class="btn-add-cart" onclick="addToCart({{id}}, '{{name}}', {{price}}); event.preventDefault(); event.stopPropagation();">
              + Agregar
            </button>
          </div>
        </div>
      </a>
      {{/each}}
    </div>
  </div>
</section>

<!-- BLOG PREVIEW -->
<section class="section blog-section">
  <div class="container">
    <div class="section-header">
      <h2>Del blog</h2>
      <a href="/blog" class="see-all">Ver todo --></a>
    </div>
    <div class="blog-grid">
      {{#each blogPosts}}
      <a href="/blog/{{id}}" target="_blank" class="blog-card blog-card-link">
        {{#if image}}
        <div class="blog-card-image">
          <img src="/uploads/{{image}}" alt="{{title}}">
        </div>
        {{/if}}
        <div class="blog-meta">
          <span class="blog-category">{{category}}</span>
          <span class="blog-date">{{date}}</span>
        </div>
        <h3>{{title}}</h3>
        <p>{{excerpt}}</p>
      </a>
      {{/each}}
    </div>
  </div>
</section>