    </div>
  </div>
</section>

<script>
// Rotación de iconos (solo perro, gato y corazón)
const iconMap = {
  perro: {
    svg: `<svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <ellipse cx="32" cy="36" rx="16" ry="14" stroke="#EE5804" stroke-width="2.5" fill="none"/>
            <path d="M16 28L12 34L18 30" stroke="#EE5804" stroke-width="2.5" fill="none" stroke-linecap="round"/>
            <path d="M48 28L52 34L46 30" stroke="#EE5804" stroke-width="2.5" fill="none" stroke-linecap="round"/>
            <circle cx="26" cy="34" r="2.5" fill="#EE5804"/>
            <circle cx="38" cy="34" r="2.5" fill="#EE5804"/>
            <ellipse cx="32" cy="42" rx="6" ry="4" stroke="#EE5804" stroke-width="2" fill="none"/>
            <circle cx="32" cy="40" r="1.5" fill="#EE5804"/>
            <path d="M30 44C30 47 34 47 34 44" stroke="#EE5804" stroke-width="1.8" fill="none" stroke-linecap="round"/>
          </svg>`,
    message: "¡Hola! 🐕"
  },
  gato: {
    svg: `<svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="32" cy="36" r="14" stroke="#EE5804" stroke-width="2.5" fill="none"/>
            <path d="M20 28L16 20L24 24" stroke="#EE5804" stroke-width="2.5" fill="none" stroke-linecap="round"/>
            <path d="M44 28L48 20L40 24" stroke="#EE5804" stroke-width="2.5" fill="none" stroke-linecap="round"/>
            <circle cx="26" cy="34" r="2" fill="#EE5804"/>
            <circle cx="38" cy="34" r="2" fill="#EE5804"/>
            <path d="M28 40L32 43L36 40" stroke="#EE5804" stroke-width="2" fill="none" stroke-linecap="round"/>
            <circle cx="32" cy="38" r="1.5" fill="#EE5804"/>
            <line x1="22" y1="38" x2="14" y2="36" stroke="#EE5804" stroke-width="1.5"/>
            <line x1="22" y1="40" x2="14" y2="42" stroke="#EE5804" stroke-width="1.5"/>
            <line x1="42" y1="38" x2="50" y2="36" stroke="#EE5804" stroke-width="1.5"/>
            <line x1="42" y1="40" x2="50" y2="42" stroke="#EE5804" stroke-width="1.5"/>
          </svg>`,
    message: "¡Miau! 🐱"
  },
  corazon: {
    svg: `<svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M32 56L28.5 52.8C16.5 41.6 8 34 8 24.8 8 17.6 13.6 12 20.8 12c4.8 0 9.6 2.4 11.2 6.4 1.6-4 6.4-6.4 11.2-6.4 7.2 0 12.8 5.6 12.8 12.8 0 9.2-8.5 16.8-20.5 28L32 56z" 
                  stroke="#EE5804" stroke-width="2.5" fill="none"/>
          </svg>`,
    message: "Con amor ❤️"
  }
};

let currentIconIndex = 0;
const iconKeys = ['perro', 'gato', 'corazon'];

setInterval(() => {
  currentIconIndex = (currentIconIndex + 1) % iconKeys.length;
  const currentKey = iconKeys[currentIconIndex];
  const iconElement = document.getElementById('heroIcon');
  const bubbleElement = document.getElementById('heroBubble');
  
  if (iconElement && bubbleElement) {
    iconElement.innerHTML = iconMap[currentKey].svg;
    bubbleElement.textContent = iconMap[currentKey].message;
    
    iconElement.style.transform = 'scale(1.1)';
    setTimeout(() => {
      iconElement.style.transform = 'scale(1)';
    }, 200);
  }
}, 4000);
</script>

<style>
/* Animaciones para los iconos */
.animal-paw-icon {
  transition: transform 0.3s ease;
  display: inline-block;
}

.animal-paw-icon svg {
  transition: all 0.3s ease;
}

.animal-card:hover .animal-paw-icon svg {
  transform: scale(1.05);
  filter: drop-shadow(0 4px 8px rgba(238, 88, 4, 0.2));
}

.animal-bubble {
  transition: all 0.3s ease;
}

.animal-card:hover .animal-bubble {
  transform: translateY(-2px);
}

/* Estilo para la tarjeta de iconos */
.animal-card {
  background: white;
  border-radius: 32px;
  padding: 20px;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  text-align: center;
}

.animal-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px rgba(238, 88, 4, 0.15);
}

.animal-card-2 {
  opacity: 0.8;
}

.hero-chip {
  background: white;
  border-radius: 100px;
  padding: 8px 16px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 500;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.animal-label {
  font-size: 14px;
  font-weight: 500;
  color: #EE5804;
  margin-top: 12px;
  margin-bottom: 0;
}

.animal-bubble {
  background: #FFF5F0;
  border-radius: 20px;
  padding: 6px 14px;
  font-size: 13px;
  color: #EE5804;
  display: inline-block;
  margin-top: 10px;
  font-weight: 500;
}

.animal-bubble-2 {
  background: rgba(238, 88, 4, 0.6);
  font-size: 11px;
  padding: 4px 10px;
  color: white !important;
}

.animal-card-2-label {
  font-size: 11px;
  color: #666;
  display: block;
  margin-top: 6px;
}
</style>




<!-- ═══════════════════════════════════
     PROMO BANNER (condicional)
═══════════════════════════════════ -->
{{#if promo.active}}
<div class="promo-banner" style="background:{{promo.bgColor}}">
  {{#if promo.imageUrl}}<img src="{{promo.imageUrl}}" alt="" class="promo-banner-img">{{/if}}
  <div class="promo-banner-content">
    <strong>{{promo.title}}</strong>
    <span>{{promo.text}}</span>
    {{#if promo.ctaText}}<a href="{{promo.ctaUrl}}" class="promo-banner-cta">{{promo.ctaText}} →</a>{{/if}}
  </div>
  <button class="promo-close" onclick="this.parentElement.style.display='none'">✕</button>
</div>
{{/if}}


<!-- ═══════════════════════════════════
     PRODUCTOS DESTACADOS
═══════════════════════════════════ -->
<section class="section featured-section">
  <div class="container">
    <div class="section-header">
      <div>
        <p class="section-eyebrow">Los más queridos</p>
        <h2>Productos destacados</h2>
      </div>
      <a href="/tienda" class="see-all">Ver todo →</a>
    </div>

    <div class="products-grid">
      {{#each products}}
      <a href="/producto/{{id}}" class="product-card">
        {{#if badge}}<span class="product-badge">{{badge}}</span>{{/if}}

        <div class="product-image-wrap">
          {{#if image}}
            <img src="/uploads/{{image}}" alt="{{name}}" class="product-img">
          {{else}}
            <div class="product-img-placeholder">
              <svg width="52" height="52" viewBox="0 0 100 100">
                <ellipse cx="50" cy="63" rx="20" ry="16" fill="#EDD9CA"/>
                <ellipse cx="26" cy="50" rx="9" ry="12" fill="#EDD9CA"/>
                <ellipse cx="74" cy="50" rx="9" ry="12" fill="#EDD9CA"/>
                <ellipse cx="36" cy="35" rx="8" ry="10" fill="#EDD9CA"/>
                <ellipse cx="64" cy="35" rx="8" ry="10" fill="#EDD9CA"/>
              </svg>
            </div>
          {{/if}}
        </div>

        <div class="product-info">
          <span class="product-pet-tag">{{petLabel pet pet_name}}</span>
          <h3>{{name}}</h3>
          <p>{{description}}</p>
          <div class="product-footer">
            <div class="product-price-wrap">
              <span class="product-price">${{price}}</span>
              <small class="product-currency">MXN</small>
            </div>
            <button class="btn-add-cart"
              onclick="addToCart({{id}}, '{{name}}', {{price}}); event.preventDefault(); event.stopPropagation();">
              + Agregar
            </button>
          </div>
        </div>
      </a>
      {{/each}}
    </div>
  </div>
</section>


