<style>
  @import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');
  .ab{font-family:'Baloo 2',cursive;--or:#EE5804;--or-pale:#FFF0E8;--or-soft:#FFD9C2;--cream:#FDF6F0;--border:#EDD9CA;--txt:#2D1A0E;--txt-mid:#6B3E26;--txt-light:#A0714F;--wh:#fff;--rad:18px;--rad-sm:10px;background:var(--cream);padding:64px 32px 80px;box-sizing:border-box}
  .ab *{box-sizing:border-box;margin:0;padding:0}
  .ab-inner{max-width:1080px;margin:0 auto}

  /* hero row */
  .ab-hero{display:flex;align-items:center;gap:64px;margin-bottom:80px}
  .ab-hero-txt{flex:1}
  .ab-eyebrow{display:inline-flex;align-items:center;gap:8px;background:var(--or-pale);border:1.5px solid var(--or-soft);border-radius:50px;padding:6px 18px;font-size:13px;font-weight:700;color:var(--or);letter-spacing:.4px;margin-bottom:22px}
  .ab-eyebrow svg{flex-shrink:0}
  .ab-hero h1{font-size:clamp(2rem,4vw,3rem);font-weight:800;line-height:1.15;color:var(--txt);margin-bottom:20px}
  .ab-hero h1 em{color:var(--or);font-style:normal}
  .ab-hero p{font-size:1.05rem;color:var(--txt-mid);line-height:1.7;max-width:520px}
  .ab-hero-visual{flex-shrink:0;width:220px;height:220px;position:relative}
  .ab-circle{width:220px;height:220px;border-radius:50%;background:var(--or-pale);border:2.5px solid var(--or-soft);display:flex;align-items:center;justify-content:center}
  .ab-paw{animation:float 4s ease-in-out infinite}
  @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
  .ab-dot{position:absolute;width:14px;height:14px;border-radius:50%;background:var(--or)}
  .ab-dot-1{top:10px;right:20px}
  .ab-dot-2{bottom:22px;left:6px;width:9px;height:9px;opacity:.5}
  .ab-dot-3{top:50%;right:-10px;width:20px;height:20px;background:var(--or-soft)}

  /* divider */
  .ab-divider{display:flex;align-items:center;gap:16px;margin-bottom:56px}
  .ab-divider-line{flex:1;height:1.5px;background:var(--border)}
  .ab-divider-label{font-size:12px;font-weight:700;color:var(--txt-light);letter-spacing:1.5px;text-transform:uppercase;white-space:nowrap}

  /* locations */
  .ab-locs{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:72px}
  .ab-loc{background:var(--wh);border:2px solid var(--border);border-radius:var(--rad);padding:28px 28px 28px;position:relative;overflow:hidden;transition:border-color .2s,transform .2s}
  .ab-loc:hover{border-color:var(--or);transform:translateY(-4px)}
  .ab-loc::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:var(--or);border-radius:4px 4px 0 0}
  .ab-loc-icon{width:44px;height:44px;border-radius:var(--rad-sm);background:var(--or-pale);display:flex;align-items:center;justify-content:center;margin-bottom:16px}
  .ab-loc h3{font-size:1rem;font-weight:800;color:var(--txt);margin-bottom:8px}
  .ab-loc-desc{font-size:.9rem;color:var(--txt-mid);line-height:1.6;margin-bottom:14px}
  .ab-loc-addr{display:flex;align-items:flex-start;gap:10px;background:var(--cream);border-radius:var(--rad-sm);padding:12px 14px}
  .ab-loc-addr svg{flex-shrink:0;margin-top:2px}
  .ab-loc-addr p{font-size:.82rem;font-weight:600;color:var(--txt-mid);line-height:1.5}

  /* pillars */
  .ab-pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:72px}
  .ab-pillar{display:flex;flex-direction:column;align-items:flex-start;gap:14px;background:var(--wh);border:2px solid var(--border);border-radius:var(--rad);padding:26px 24px;transition:border-color .2s}
  .ab-pillar:hover{border-color:var(--or)}
  .ab-pillar-icon{width:48px;height:48px;border-radius:12px;background:var(--or-pale);display:flex;align-items:center;justify-content:center}
  .ab-pillar h3{font-size:.95rem;font-weight:800;color:var(--txt)}
  .ab-pillar p{font-size:.87rem;color:var(--txt-mid);line-height:1.6}

  /* CTA strip */
  .ab-cta{display:flex;align-items:center;justify-content:space-between;gap:24px;background:var(--or);border-radius:var(--rad);padding:32px 40px;flex-wrap:wrap}
  .ab-cta-txt h2{font-size:1.3rem;font-weight:800;color:#fff;margin-bottom:6px}
  .ab-cta-txt p{font-size:.92rem;color:rgba(255,255,255,.82)}
  .ab-cta-contacts{display:flex;gap:16px;flex-wrap:wrap}
  .ab-cta-chip{display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.15);border:1.5px solid rgba(255,255,255,.3);border-radius:50px;padding:10px 20px}
  .ab-cta-chip svg{flex-shrink:0}
  .ab-cta-chip span{font-size:.9rem;font-weight:700;color:#fff}

  /* ========== FADE ANIMATIONS ========== */
  .fade-up {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s cubic-bezier(0.2, 0.9, 0.4, 1.1), transform 0.6s cubic-bezier(0.2, 0.9, 0.4, 1.1);
  }
  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .fade-left {
    opacity: 0;
    transform: translateX(-25px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .fade-left.visible {
    opacity: 1;
    transform: translateX(0);
  }
  .fade-right {
    opacity: 0;
    transform: translateX(25px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .fade-right.visible {
    opacity: 1;
    transform: translateX(0);
  }
  .stagger-item {
    transition-delay: 0.05s;
  }
  .stagger-item:nth-child(1) { transition-delay: 0.05s; }
  .stagger-item:nth-child(2) { transition-delay: 0.15s; }
  .stagger-item:nth-child(3) { transition-delay: 0.25s; }
</style>

