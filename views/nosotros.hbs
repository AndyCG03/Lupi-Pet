<style>
  @import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&display=swap');
  
  .ab {
    font-family: 'Baloo 2', cursive;
    --or: #EE5804;
    --or-pale: #FFF0E8;
    --or-soft: #FFD9C2;
    --cream: #FDF6F0;
    --border: #EDD9CA;
    --txt: #2D1A0E;
    --txt-mid: #6B3E26;
    --txt-light: #A0714F;
    --wh: #fff;
    --rad: 18px;
    --rad-sm: 10px;
    background: var(--cream);
    padding: clamp(32px, 5vw, 64px) clamp(16px, 4vw, 32px) clamp(48px, 8vw, 80px);
    box-sizing: border-box;
    min-height: 100vh;
  }
  
  .ab * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  
  .ab-inner {
    max-width: 1080px;
    margin: 0 auto;
  }

  /* ========== HERO ROW - RESPONSIVE ========== */
  .ab-hero {
    display: flex;
    align-items: center;
    gap: clamp(30px, 5vw, 64px);
    margin-bottom: clamp(40px, 8vw, 80px);
    flex-wrap: wrap;
  }
  
  .ab-hero-txt {
    flex: 1;
    min-width: 250px;
  }
  
  .ab-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--or-pale);
    border: 1.5px solid var(--or-soft);
    border-radius: 50px;
    padding: 6px 18px;
    font-size: clamp(11px, 3vw, 13px);
    font-weight: 700;
    color: var(--or);
    letter-spacing: 0.4px;
    margin-bottom: 22px;
  }
  
  .ab-hero h1 {
    font-size: clamp(1.8rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--txt);
    margin-bottom: 20px;
  }
  
  /* Estilo para "Lupi" en naranja y "Pez" en oscuro */
  .ab-hero h1 .lupi-name {
    color: var(--or);
  }
  
  .ab-hero h1 .pez-name {
    color: var(--txt);
  }
  
  .ab-hero h1 em {
    color: var(--or);
    font-style: normal;
  }
  
  .ab-hero p {
    font-size: clamp(0.9rem, 3vw, 1.05rem);
    color: var(--txt-mid);
    line-height: 1.6;
    max-width: 520px;
  }
  
  .ab-hero-visual {
    flex-shrink: 0;
    width: clamp(160px, 30vw, 220px);
    height: clamp(160px, 30vw, 220px);
    position: relative;
    margin: 0 auto;
  }
  
  .ab-circle {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--or-pale);
    border: 2.5px solid var(--or-soft);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .ab-heart {
    animation: heartbeat 1.5s ease-in-out infinite;
  }
  
  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }
  
  .ab-dot {
    position: absolute;
    width: clamp(8px, 2vw, 14px);
    height: clamp(8px, 2vw, 14px);
    border-radius: 50%;
    background: var(--or);
  }
  
  .ab-dot-1 {
    top: 10px;
    right: 20px;
  }
  
  .ab-dot-2 {
    bottom: 22px;
    left: 6px;
    width: 9px;
    height: 9px;
    opacity: 0.5;
  }
  
  .ab-dot-3 {
    top: 50%;
    right: -10px;
    width: 20px;
    height: 20px;
    background: var(--or-soft);
  }

  /* ========== DIVIDER - RESPONSIVE ========== */
  .ab-divider {
    display: flex;
    align-items: center;
    gap: clamp(10px, 3vw, 16px);
    margin-bottom: clamp(30px, 6vw, 56px);
  }
  
  .ab-divider-line {
    flex: 1;
    height: 1.5px;
    background: var(--border);
  }
  
  .ab-divider-label {
    font-size: clamp(10px, 2.5vw, 12px);
    font-weight: 700;
    color: var(--txt-light);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ========== LOCATIONS - RESPONSIVE GRID ========== */
  .ab-locs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: clamp(40px, 8vw, 72px);
  }
  
  .ab-loc {
    background: var(--wh);
    border: 2px solid var(--border);
    border-radius: var(--rad);
    padding: clamp(20px, 4vw, 28px);
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }
  
  .ab-loc:hover {
    border-color: var(--or);
    transform: translateY(-4px);
  }
  
  .ab-loc::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--or);
    border-radius: 4px 4px 0 0;
  }
  
  .ab-loc-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--rad-sm);
    background: var(--or-pale);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }
  
  .ab-loc h3 {
    font-size: clamp(0.9rem, 3vw, 1rem);
    font-weight: 800;
    color: var(--txt);
    margin-bottom: 8px;
  }
  
  .ab-loc-desc {
    font-size: clamp(0.8rem, 2.5vw, 0.9rem);
    color: var(--txt-mid);
    line-height: 1.6;
    margin-bottom: 14px;
  }
  
  .ab-loc-addr {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: var(--cream);
    border-radius: var(--rad-sm);
    padding: 12px 14px;
  }
  
  .ab-loc-addr svg {
    flex-shrink: 0;
    margin-top: 2px;
  }
  
  .ab-loc-addr p {
    font-size: clamp(0.75rem, 2.3vw, 0.82rem);
    font-weight: 600;
    color: var(--txt-mid);
    line-height: 1.5;
  }

  /* ========== PILLARS - RESPONSIVE GRID ========== */
  .ab-pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-bottom: clamp(40px, 8vw, 72px);
  }
  
  .ab-pillar {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    background: var(--wh);
    border: 2px solid var(--border);
    border-radius: var(--rad);
    padding: clamp(20px, 4vw, 26px) clamp(18px, 4vw, 24px);
    transition: border-color 0.2s;
  }
  
  .ab-pillar:hover {
    border-color: var(--or);
  }
  
  .ab-pillar-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--or-pale);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .ab-pillar h3 {
    font-size: clamp(0.85rem, 3vw, 0.95rem);
    font-weight: 800;
    color: var(--txt);
  }
  
  .ab-pillar p {
    font-size: clamp(0.8rem, 2.5vw, 0.87rem);
    color: var(--txt-mid);
    line-height: 1.6;
  }

  /* ========== CTA STRIP - RESPONSIVE ========== */
  .ab-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: var(--or);
    border-radius: var(--rad);
    padding: clamp(24px, 5vw, 32px) clamp(20px, 5vw, 40px);
    flex-wrap: wrap;
  }
  
  .ab-cta-txt {
    flex: 1;
    min-width: 200px;
  }
  
  .ab-cta-txt h2 {
    font-size: clamp(1.1rem, 4vw, 1.3rem);
    font-weight: 800;
    color: #fff;
    margin-bottom: 6px;
  }
  
  .ab-cta-txt p {
    font-size: clamp(0.8rem, 2.5vw, 0.92rem);
    color: rgba(255, 255, 255, 0.85);
  }
  
  .ab-cta-contacts {
    display: flex;
    gap: clamp(12px, 3vw, 16px);
    flex-wrap: wrap;
  }
  
  .ab-cta-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.15);
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    border-radius: 50px;
    padding: clamp(8px, 2vw, 10px) clamp(16px, 3vw, 20px);
    white-space: nowrap;
  }
  
  @media (max-width: 640px) {
    .ab-cta-chip {
      white-space: normal;
      word-break: break-word;
    }
  }
  
  .ab-cta-chip svg {
    flex-shrink: 0;
  }
  
  .ab-cta-chip span {
    font-size: clamp(0.8rem, 2.5vw, 0.9rem);
    font-weight: 700;
    color: #fff;
  }

  /* ========== FADE ANIMATIONS ========== */
  .fade-up {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s cubic-bezier(0.2, 0.9, 0.4, 1.1), transform 0.6s cubic-bezier(0.2, 0.9, 0.4, 1.1);
  }
  
  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }
  
  .fade-left {
    opacity: 0;
    transform: translateX(-25px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  
  .fade-left.visible {
    opacity: 1;
    transform: translateX(0);
  }
  
  .fade-right {
    opacity: 0;
    transform: translateX(25px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  
  .fade-right.visible {
    opacity: 1;
    transform: translateX(0);
  }
  
  .stagger-item {
    transition-delay: 0.05s;
  }
  
  .stagger-item:nth-child(1) { transition-delay: 0.05s; }
  .stagger-item:nth-child(2) { transition-delay: 0.15s; }
  .stagger-item:nth-child(3) { transition-delay: 0.25s; }

  /* ========== AJUSTES ADICIONALES PARA MÓVIL ========== */
  @media (max-width: 768px) {
    .ab-hero {
      text-align: center;
      justify-content: center;
    }
    
    .ab-hero-txt {
      text-align: center;
    }
    
    .ab-hero p {
      margin-left: auto;
      margin-right: auto;
    }
    
    .ab-eyebrow {
      justify-content: center;
    }
    
    .ab-cta {
      text-align: center;
      justify-content: center;
    }
    
    .ab-cta-txt {
      text-align: center;
    }
    
    .ab-cta-contacts {
      justify-content: center;
    }
    
    .ab-divider-label {
      white-space: normal;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .ab-loc-addr p {
      word-break: break-word;
    }
    
    .ab-cta-chip {
      width: 100%;
      justify-content: center;
    }
    
    .ab-dot-3 {
      display: none;
    }
  }
</style>

