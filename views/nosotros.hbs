<script>
  // Intersection Observer para detectar cuando los elementos entran en pantalla
  (function() {
    const fadeElements = document.querySelectorAll('.fade-up, .fade-left, .fade-right');
    
    // Hacemos visibles los elementos que ya están en la clase "visible"
    // Nota: la clase 'visible' ya está puesta en el hero de ejemplo, pero para los demás la pondremos dinámicamente
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          // Una vez visible, podemos dejar de observarlo (opcional, mejora rendimiento)
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }); // Inicia cuando el 10% del elemento es visible
    
    fadeElements.forEach(el => {
      // Si ya tiene la clase 'visible' por defecto, la respetamos, pero aseguramos que se observe igual
      observer.observe(el);
    });
    
    // Forzamos un pequeño timeout para que los elementos que ya están visibles se activen correctamente
    setTimeout(() => {
      fadeElements.forEach(el => {
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight - 50) {
          el.classList.add('visible');
        }
      });
    }, 100);
  })();
</script>